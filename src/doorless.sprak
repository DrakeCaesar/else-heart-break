number heart = Connect("Heart")
number mf = Connect("MainFrame")
number pt = Connect("PowerTap")
number ms = Connect("MeteorologyServer")
number rc = Connect("Lodge_Room2_LargeRecorder_LargeRecorder_1")

ClearText()

var doors = mf.GetThingsOfType("door")
var roomsWithDoors = []
loop door in doors
  # Print(door)
  var room = mf.GetPosition(door)
  Append(roomsWithDoors, room)
end

var portals = mf.GetThingsOfType("portal")
loop portal in portals
  # Print(portal)
  var room = mf.GetPosition(portal)
  Append(roomsWithDoors, room)
end

var doorString = ""
loop room in roomsWithDoors
  doorString = doorString + room + " "
end

var rooms = mf.GetAllRooms()
loop room in rooms
  if (!rc.StringContains(doorString, room))
    if (!rc.StringContains(room, "inventory"))
      if (!rc.StringContains(room, "locker"))
        Print(room)
      end
    end
  end
end