number heart = Connect("Heart")
number mf = Connect("MainFrame")
number pt = Connect("PowerTap")
number ms = Connect("MeteorologyServer")
number rc = Connect("Lodge_Room2_LargeRecorder_LargeRecorder_1")

ClearText()

var substring = "Monad"

var doors = mf.GetThingsOfType("door")
var targetRooms = []
loop door in doors
  if (rc.StringContains(door, substring))
    var room = mf.GetPosition(door)
    Append(targetRooms, room)
  end
end

var people = mf.GetThingsOfType("bed")

loop room in targetRooms
  Print(room)
  
  var things = mf.GetThingsInRoom(room)
  loop thing in things
    loop person in people
      if (thing == person)
        var pos = mf.GetPosition(person)
        Print(person + " is at " + room + " at " + pos)
      end
    end
  end
end

Print("")
Print("Done")