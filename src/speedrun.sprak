void Cast(string name)
  var caster = Connect("PoliceOfficeInterior_LargeRecorder_LargeRecorder_1")
  caster.Broadcast(name)
end

void Sleepy()
  var heart = Connect("Heart")
  heart.SetNumericData(GetUser(), "sleepiness", 90)
end

void Interact(string name, string target)
  var interactor = Connect("LongsonPlaystation")
  interactor.InteractWith(name, target)
end

void Wait(number sec)
  var interactor = Connect("LongsonPlaystation")
  interactor.Sleep(sec)
endd

void Teleport(string name, string target)
  string recorder = "PoliceOfficeInterior_LargeRecorder_LargeRecorder_1"
  var interactor = Connect("LongsonPlaystation")
  interactor.SetPosition(recorder, name)
  var teleport = Connect(recorder)
  teleport.MovePerson(name, target)
end

void Fast()
  loop
    Cast("Sebastian_TookFastForwardDrug")
  end
end