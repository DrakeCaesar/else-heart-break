var mf = Connect("MainFrame")
var sebName = "Sebastian"
var lastRoom = ""

ClearText()
var memories = GetMemories()
loop memory in memories
  Print("Memory: " + memory)
end
Print("--------")
Print("Welcome!")
Print("--------")

loop
  var sebRoom = mf.GetRoom(sebName)
  if (lastRoom != sebRoom)
    Print("Current room: " + sebRoom)
    Print("   Last room: " + lastRoom)
    Print("")
    lastRoom = sebRoom
    var things = mf.GetThingsInRoom(sebRoom)
    loop thing in things
      var type = mf.GetTypeOfThing(thing)
      if type == "door"
        var door = Connect(thing)
        var code = 0
        var unlocked = false
        if(HasMemory(door))
          code = LoadMemory(door)
        end
        if (!door.Unlock(code))
          loop code from -65 to 100000
            
            if (Mod(code, 1000) == 0)
              Print ("Bruteforcing: " + thing + ", code: " + code)
            end
            if (door.Unlock(code))
              Print ("Unlocked:     " + thing + ", code: " + code)
              SaveMemory(door, code)
              break
            end
          end
        end
      end
    end
  end
  Sleep(1)
end


loop
  FastForward()
  QuickBoost()
  Trippy()
  Sleep(1)
end


var name = Name()
if (name == "Sebastian")
  Goto("Monad_inventory")
else
  Goto("YvonneToilet_DoorToBar")
end