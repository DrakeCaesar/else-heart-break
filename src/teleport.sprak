number ParseInt(string str)
  var i = 0
  var num = 0
  var count = Count(str)
  var minus = false
  if (str[0] == "-")
    minus = true
    i++
  end
  
  loop
    var c = str[i]
    if (c == "0")
      num = num * 10
    else if (c == "1")
      num = num * 10 + 1
    else if (c == "2")
      num = num * 10 + 2
    else if (c == "3")
      num = num * 10 + 3
    else if (c == "4")
      num = num * 10 + 4
    else if (c == "5")
      num = num * 10 + 5
    else if (c == "6")
      num = num * 10 + 6
    else if (c == "7")
      num = num * 10 + 7
    else if (c == "8")
      num = num * 10 + 8
    else if (c == "9")
      num = num * 10 + 9
    else
      break
    end
    i++
    if (i == count)
      break
    end
  end
  
  if (minus)
    return -num
  end
  return num
end

array GetCoordinates()
  var coords = Position()
  var length = Count(coords)
  var xpos = ""
  var ypos = ""
  
  var x = ""
  var i = 3
  loop
    x += coords[i]
    i++
    if (coords[i] == ",")
      break
    end
  end
  
  i = i + 5
  var y = ""
  var count = Count(coords) - 1
  loop j from i to count
    y += pos[j]
  end
  # Print(coords + " " + ParseInt(x) + " " + ParseInt(y))
  return [ParseInt(x), ParseInt(y)]
end





