var mf = Connect("MainFrame")
var substr = Connect("Lodge_Room2_LargeRecorder_LargeRecorder_1")
var rooms = mf.GetAllRooms()
var users = mf.GetPeople()

var ToLowercase(var text)
  var res = ""
  loop c in text
    if IsUppercase(c)
      res += IntToChar(CharToInt(c) + 32)
    else
      res += c
    end
  end
  return res
end
var ToUppercase(var text)
  var res = ""
  loop c in text
    if IsLowercase(c)
      res += IntToChar(CharToInt(c) - 32)
    else
      res += c
    end
  end
  return res
end
bool IsLowercase(var c)
  return CharToInt(c) >= 0 && CharToInt(c) <= 25
end
bool IsUppercase(var c)
  return CharToInt(c) >= -32 && CharToInt(c) <= -7
end
array CopyArray(array a)
  array res = []
  loop i in a
    res[Count(res)] = i
  end
  return res
end



array findSubstrings(string target, array things)
  array resultList = []
  
  loop thing in things
    var lowerTarget = ToLowercase(target)
    var lowerThing = ToLowercase(thing)
    if (substr.StringContains(lowerThing, lowerTarget))
      resultList[Count(resultList)] = thing
      Print("Match: " + thing)
    end
  end
  return resultList
end

ClearText()

var term = "NorthHarbor"
Print("Searching for: " + term)
var filteredRooms = findSubstrings(term, rooms)


loop room in filteredRooms
  var type = mf.GetTypeOfThing(room)
  Print("Type: " + type);
  Print(room)
end
Print("Done printing rooms")

