void Progress(array arr)
  var count = Count(arr)
  var width = 62
  var printedSegments = 0
  loop i from 0 to count
    var percentage = Int((i / count) * 100)
    var segments = Int((i / count) * width)
    if (segments > printedSegments)
      loop i from 0 to segments - printedSegments
        PrintS("#")
      end
      printedSegments = segments
    end
  end
  Print("")
  Print("")
end

