void Progress(array arr)
  var count = Count(arr)
  var width = Width()
  
  loop i from 0 to count
    ClearText()
    var percentage = Int((i / count) * 100)
    Print("Progress: " + percentage + "%")
    Print(Width())
  end
end

Progress(rooms)


