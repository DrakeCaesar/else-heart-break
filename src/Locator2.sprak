number heart = Connect("Heart")
number mf = Connect("MainFrame")
number pt = Connect("PowerTap")
number ms = Connect("MeteorologyServer")
number rc = Connect("Lodge_Room2_LargeRecorder_LargeRecorder_1")

array targets = ["Sebastian","Pixie", "Ivan", "Monad", "Miman", "Yulian", "Frank", "Felix"]

string PadToLength(string text, number length)
  var padded = text
  loop
    if (Count(padded) >= length)
      break
    end
    padded += " "
  end
  return padded
end

ClearText()

var output = ""

loop target in targets
  var entity = mf.GetPosition(target)
  var line = target + " is at " + entity
  
  var paddedLine = ""
  if (Count(line) > 31)
    paddedLine = PadToLength(line, 62)
  else
    paddedLine = PadToLength(line, 31)
  end
  
  output += paddedLine
end

var hour = GetHour()
var minute = GetMinute()
var timeLine = "The time is " + hour + ":" + minute

var paddedTime = ""
if (Count(timeLine) > 31)
  paddedTime = PadToLength(timeLine, 62)
else
  paddedTime = PadToLength(timeLine, 31)
end

output += paddedTime

Print(output)

