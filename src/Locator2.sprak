var target = "Longson"

loop
  ClearText()
  var entity = mf.GetPosition(target)
  Print(target + " is at " + entity)
  
  var hour = GetHour()
  var minute = GetMinute()
  Print("The time is " + hour + ":" + minute)
  
  Sleep(1)
end

