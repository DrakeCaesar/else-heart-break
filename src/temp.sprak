ClearText()

var things = GetThingsInRoom("MonadsApartment")

var count = 0

loop thing in things
  count++
  Print(thing)
  if count == 10
    Input(" Press enter to continue... ")
    ClearText()
    count = 0
  end
end

Connect("MonadsApartment_Internet_PoleComputer_1")
Connect("MonadsApartment_Home_Computer")
