number heart = Connect("Heart")
number mf = Connect("Mainframe")
number pt = Connect("PowerTap")
number ms = Connect("MeteorologicalServer")
number rc = Connect("Ministry_ChamberOfNumbers_LargeRecorder_LargeRecorder_4")

ClearText()
string encrypted = "a00j ksdhg 245kljshg a sl3434 kjghklj434 651 xsdhgkl"

var bigString = ""
var count = 0

loop k from 0 to 1000
  string decrypted = ""
  
  loop c in encrypted
    if c == " "
      decrypted += " "
    else
      var diff = CharToInt(c) - k
      
      if diff < 0
        diff += 25
      end
      
      var originalChar = IntToChar(Mod(diff, 25))
      decrypted += originalChar
    end
  end
  
  Print(decrypted)
  count++
  if (rc.StringContains(bigString, decrypted))
    Print(count)
    break
  end
  bigString += decrypted
end