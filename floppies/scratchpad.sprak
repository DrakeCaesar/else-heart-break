var heart = Connect("Heart")
number mf = Connect("MainFrame")
number pt = Connect("PowerTap")
number ms = Connect("MeteorologyServer")
number rc = Connect("Ministry_ChamberOfNumbers_LargeRecorder_LargeRecorder_4")

ClearText()

var types = ["floppy"]

loop type in types
  var things = mf.GetThingsOfType(type)
  loop thing in things
    Print(thing)
    mf.SetPosition(thing, "SebastianCreditCard")
  end
end


